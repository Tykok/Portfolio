# Absolute URL the site is served from, without a trailing slash.
# Substituted into index.html at build time for canonical, og:url and og:image,
# which crawlers only accept as absolute URLs. Set it in CI for production.
VITE_SITE_URL=https://portfolio.example.com

# Serve projects from the in-repo mock (default). Set to false to call the API.
VITE_USE_MOCK=true

# Base URL of the projects API. Only read when VITE_USE_MOCK=false.
VITE_API_URL=
